generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  password       String
  name           String
  avatar         String?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  notifications  Notification[]
  refreshTokens  RefreshToken[]
  ticketComments TicketComment[]
  userCompanies  UserCompany[]
  templates      Template[]

  @@map("users")
}

model Company {
  id                 String              @id @default(cuid())
  name               String
  logo               String?
  industry           String?
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  activities         Activity[]
  clients            Client[]
  contracts          Contract[]
  customRoles        CustomRole[]
  documents          Document[]
  employees          Employee[]          @relation("CompanyEmployees")
  expenses           Expense[]
  incomes            Income[]
  marketingCampaigns MarketingCampaign[]
  opportunities      Opportunity[]
  payrolls           Payroll[]           @relation("CompanyPayrolls")
  pipelineColumns    PipelineColumn[]
  productCategories  ProductCategory[]
  products           Product[]
  purchaseRequests   PurchaseRequest[]
  quotes             Quote[]
  tickets            Ticket[]
  userCompanies      UserCompany[]
  departments        Department[]
  templates          Template[]

  // Configuración de Plantillas (Proformas y Facturas)
  quotePrimaryColor   String? @map("quote_primary_color")
  quoteHeaderHtml     String? @map("quote_header_html") @db.Text
  quoteFooterHtml     String? @map("quote_footer_html") @db.Text
  quoteTerms          String? @map("quote_terms") @db.Text
  invoicePrimaryColor String? @map("invoice_primary_color")
  invoiceHeaderHtml   String? @map("invoice_header_html") @db.Text
  invoiceFooterHtml   String? @map("invoice_footer_html") @db.Text
  ticketStages        Json?   @map("ticket_stages")

  @@map("companies")
}

model UserCompany {
  id           String      @id @default(cuid())
  userId       String      @map("user_id")
  companyId    String      @map("company_id")
  role         UserRole    @default(USER)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  customRoleId String?     @map("custom_role_id")
  custom_role  String?
  customRole   CustomRole? @relation(fields: [customRoleId], references: [id], onUpdate: NoAction, map: "fk_user_companies_custom_role")
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@map("user_companies")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Income {
  id                String       @id @default(cuid())
  companyId         String       @map("company_id")
  refNumber         String       @map("ref_number")
  client            String
  concept           String
  method            String
  amount            Float
  margin            Float
  status            IncomeStatus @default(PENDING)
  date              DateTime
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  amountSecondary   Float?       @map("amount_secondary")
  currency          String?      @default("USD")
  currencySecondary String?      @map("currency_secondary")
  customFields      Json?        @map("custom_fields")
  documento         String?
  exchangeRate      Float?       @map("exchange_rate")
  folio             String?
  origen            String?
  clientId          String?      @map("client_id")
  clientRelation    Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  company           Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("incomes")
}

model Expense {
  id               String            @id @default(cuid())
  companyId        String            @map("company_id")
  refNumber        String?           @map("ref_number")
  provider         String
  concept          String
  category         String
  method           String
  amount           Float
  status           ExpenseStatus     @default(PENDING)
  date             DateTime
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payrolls         Payroll[]         @relation("ExpensePayrolls")
  purchaseRequests PurchaseRequest[] @relation("ExpensePurchaseRequests")

  @@map("expenses")
}

model Opportunity {
  id            String           @id @default(cuid())
  companyId     String           @map("company_id")
  title         String
  client        String
  value         Float
  stage         OpportunityStage @default(PROSPECTO)
  status        String           @default("Pendiente")
  order         Int              @default(0)
  assignedTo    String?          @map("assigned_to")
  assignedUsers String?          @map("assigned_users") // JSON array de IDs de usuarios asignados
  currency      String           @default("USD") // USD o NIO (C$)
  closeDate     DateTime?        @map("close_date")
  priority      String?          @default("MEDIA")
  description   String?
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("opportunities")
}

model Document {
  id         String       @id @default(cuid())
  companyId  String       @map("company_id")
  name       String
  type       DocumentType
  concept    String
  category   String?
  area       String?      @default("General")
  visibility String?      @default("COMPARTIDO")
  sharedWith String?      @map("shared_with") // JSON array de IDs de usuarios con acceso
  fileUrl    String       @map("file_url")
  fileSize   Int          @map("file_size")
  uploadedBy String       @map("uploaded_by")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  company    Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("documents")
}

model Contract {
  id         String         @id @default(cuid())
  companyId  String         @map("company_id")
  contractId String         @map("contract_id")
  name       String
  concept    String
  category   String?
  party      String
  startDate  DateTime       @map("start_date")
  endDate    DateTime       @map("end_date")
  status     ContractStatus @default(ACTIVE)
  area       String?        @default("General")
  visibility String?        @default("COMPARTIDO")
  sharedWith String?        @map("shared_with") // JSON array de IDs de usuarios/áreas con acceso
  fileUrl    String?        @map("file_url")
  uploadedBy String         @map("uploaded_by")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("contracts")
}

model Client {
  id            String       @id @default(cuid())
  companyId     String       @map("company_id")
  name          String
  email         String?
  phone         String?
  address       String?
  taxId         String?      @map("tax_id")
  status        ClientStatus @default(PROSPECTO)
  contactName   String?      @map("contact_name")
  notes         String?
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  cedula        String?
  city          String?
  country       String?
  ruc           String?
  alias         String?
  codigoInterno String?      @map("codigo_interno")
  contribuyente String?
  curso         String?
  customFields  Json?        @map("custom_fields")
  origen        String?
  phone2        String?
  sucursal      String?
  telefonoTutor String?      @map("telefono_tutor")
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quotes        Quote[]
  tickets       Ticket[]
  incomes       Income[]

  @@index([companyId])
  @@index([status])
  @@map("clients")
}

model Quote {
  id               String        @id @default(cuid())
  quoteNumber      String        @unique @map("quote_number")
  companyId        String        @map("company_id")
  clientId         String        @map("client_id")
  contactName      String?       @map("contact_name") // Nombre del contacto
  contactEmail     String?       @map("contact_email")
  contactPhone     String?       @map("contact_phone")
  assignedTo       String?       @map("assigned_to") // Vendedor asignado (ID de usuario)
  clientType       ClientType    @default(NUEVO) @map("client_type") // Nuevo, Recurrente, Proyecto
  status           QuoteStatus   @default(DRAFT)
  closeProbability Int?          @default(50) @map("close_probability") // Probabilidad de cierre (0-100)
  currency         String        @default("USD")
  subtotal         Float
  discount         Float         @default(0)
  tax              Float         @default(0)
  total            Float
  issueDate        DateTime      @default(now()) @map("issue_date") // Fecha de emisión
  validUntil       DateTime      @map("valid_until") // Fecha de vencimiento
  sentAt           DateTime?     @map("sent_at") // Fecha de envío
  approvedAt       DateTime?     @map("approved_at") // Fecha de aprobación
  rejectedAt       DateTime?     @map("rejected_at") // Fecha de rechazo
  rejectionReason  String?       @map("rejection_reason") // Motivo de rechazo
  closedAt         DateTime?     @map("closed_at") // Fecha de cierre
  notes            String?
  internalNotes    String?       @map("internal_notes")
  terms            String?
  createdBy        String        @map("created_by")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  paymentMethod    PaymentMethod @default(CONTADO) @map("payment_method")
  taxApplies       Boolean       @default(true) @map("tax_applies")
  items            QuoteItem[]
  client           Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  company          Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([clientId])
  @@index([status])
  @@index([assignedTo])
  @@index([clientType])
  @@map("quotes")
}

model QuoteItem {
  id          String   @id @default(cuid())
  quoteId     String   @map("quote_id")
  productId   String?  @map("product_id")
  description String
  quantity    Int
  unitPrice   Float    @map("unit_price")
  discount    Float    @default(0)
  tax         Float    @default(0)
  total       Float
  createdAt   DateTime @default(now()) @map("created_at")
  product     Product? @relation(fields: [productId], references: [id])
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("quote_items")
}

model Product {
  id                   String                @id @default(cuid())
  companyId            String                @map("company_id")
  categoryId           String?               @map("category_id")
  name                 String
  sku                  String
  description          String?
  unit                 String                @default("UNI")
  stock                Int                   @default(0)
  minStock             Int                   @default(0) @map("min_stock")
  cost                 Float                 @default(0)
  price                Float
  isActive             Boolean               @default(true) @map("is_active")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  category             ProductCategory?      @relation(fields: [categoryId], references: [id])
  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quoteItems           QuoteItem[]
  purchaseRequestItems PurchaseRequestItem[]

  @@unique([companyId, sku])
  @@index([companyId])
  @@index([categoryId])
  @@map("products")
}

model ProductCategory {
  id          String    @id @default(cuid())
  companyId   String    @map("company_id")
  name        String
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products    Product[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("product_categories")
}

model Ticket {
  id            String     @id @default(cuid())
  ticketNumber  String     @unique @map("ticket_number") // Número autogenerado
  companyId     String     @map("company_id")
  clientId      String?    @map("client_id")
  title         String
  description   String?    @db.Text
  type          TicketType @default(SOPORTE_REMOTO) // Tipo de solicitud
  status        String     @default("PROCESO1")
  priority      String?    @default("MEDIA")
  assignedTo    String?    @map("assigned_to")
  assignedUsers String?    @map("assigned_users") // JSON array de IDs de usuarios asignados
  branch        String? // Sucursal o área
  amount        Float?
  currency      String     @default("USD") // USD o NIO (C$)
  startDate     DateTime?  @map("start_date")
  dueDate       DateTime?  @map("due_date")
  closedAt      DateTime?  @map("closed_at")
  attachments   String? // JSON array de URLs de archivos adjuntos

  // Información técnica
  equipmentType    String?   @map("equipment_type") // DVR, NVR, cámara IP, analógica
  equipmentBrand   String?   @map("equipment_brand")
  equipmentModel   String?   @map("equipment_model")
  serialNumber     String?   @map("serial_number")
  installationDate DateTime? @map("installation_date")
  installedBy      String?   @map("installed_by") // ID del técnico que instaló
  evidence         String? // JSON array de URLs de fotos/videos

  // Métricas
  responseTime   Int? @map("response_time") // Tiempo de respuesta en minutos
  resolutionTime Int? @map("resolution_time") // Tiempo de resolución en minutos
  reopenedCount  Int  @default(0) @map("reopened_count") // Veces que se reabrió

  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  client   Client?         @relation(fields: [clientId], references: [id])
  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  comments TicketComment[]

  @@index([companyId])
  @@index([status])
  @@index([priority])
  @@index([type])
  @@index([assignedTo])
  @@index([clientId])
  @@index([ticketNumber])
  @@map("tickets")
}

model TicketComment {
  id            String   @id @default(cuid())
  ticketId      String   @map("ticket_id")
  userId        String   @map("user_id")
  content       String   @db.Text
  attachmentUrl String?  @map("attachment_url")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  ticket        Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([userId])
  @@map("ticket_comments")
}

model Activity {
  id          String         @id @default(cuid())
  companyId   String         @map("company_id")
  type        ActivityType
  title       String
  description String?
  client      String?
  status      ActivityStatus @default(PENDING)
  priority    String?
  assignedTo  String?        @map("assigned_to")
  dueDate     DateTime       @map("due_date")
  completedAt DateTime?      @map("completed_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  meetingLink String?        @map("meeting_link")
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("activities")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  type      String
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model PipelineColumn {
  id        String   @id @default(cuid())
  companyId String   @map("company_id")
  user_id   String?
  name      String
  color     String   @default("#6366f1")
  order     Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, user_id, name])
  @@index([companyId])
  @@index([user_id])
  @@map("pipeline_columns")
}

model CustomRole {
  id            String           @id @default(cuid()) @db.VarChar(30)
  companyId     String           @map("company_id") @db.VarChar(30)
  name          String           @db.VarChar(255)
  description   String?
  color         String           @default("#6366f1") @db.VarChar(20)
  is_default    Boolean          @default(false)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  permissions   RolePermission[]
  userCompanies UserCompany[]

  @@unique([companyId, name])
  @@map("custom_roles")
}

model RolePermission {
  id           String     @id @default(cuid()) @db.VarChar(30)
  customRoleId String     @map("custom_role_id") @db.VarChar(30)
  module       String     @db.VarChar(100)
  canView      Boolean    @default(false) @map("can_view")
  canCreate    Boolean    @default(false) @map("can_create")
  canEdit      Boolean    @default(false) @map("can_edit")
  canDelete    Boolean    @default(false) @map("can_delete")
  canExport    Boolean    @default(false) @map("can_export")
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  updated_at   DateTime   @default(now()) @db.Timestamptz(6)
  customRole   CustomRole @relation(fields: [customRoleId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([customRoleId, module])
  @@map("role_permissions")
}

model MarketingCampaign {
  id             String           @id @default(cuid())
  companyId      String           @map("company_id")
  name           String
  description    String?
  channel        MarketingChannel
  status         MarketingStatus  @default(PLANIFICACION)
  budget         Float?
  spent          Float            @default(0)
  startDate      DateTime?        @map("start_date")
  endDate        DateTime?        @map("end_date")
  targetAudience String?          @map("target_audience")
  metrics        String?
  assignedTo     String?          @map("assigned_to")
  createdBy      String           @map("created_by")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([status])
  @@index([channel])
  @@map("marketing_campaigns")
}

model Employee {
  id                   String    @id @default(cuid())
  companyId            String    @map("company_id")
  employeeCode         String    @unique @map("employee_code")
  fullName             String    @map("full_name")
  email                String?
  phone                String?
  position             String
  department           String
  startDate            DateTime  @map("start_date")
  salary               Float
  contractType         String    @map("contract_type")
  bankName             String?   @map("bank_name")
  accountNumber        String?   @map("account_number")
  address              String?
  birthDate            DateTime? @map("birth_date")
  emergencyContact     String?   @map("emergency_contact")
  emergencyPhone       String?   @map("emergency_phone")
  socialSecurityNumber String?   @map("social_security_number")
  bloodType            String?   @map("blood_type")
  educationLevel       String?   @map("education_level")
  benefits             String?   @db.Text
  status               String    @default("ACTIVO")
  photo                String?
  notes                String?   @db.Text
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  company              Company   @relation("CompanyEmployees", fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([status])
  @@index([employeeCode])
  @@map("employees")
}

model Payroll {
  id          String   @id @default(cuid())
  companyId   String
  name        String?
  period      String
  fileName    String
  fileUrl     String
  totalAmount Float
  status      String   @default("PENDIENTE")
  notes       String?
  expenseId   String?
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  company     Company  @relation("CompanyPayrolls", fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  expense     Expense? @relation("ExpensePayrolls", fields: [expenseId], references: [id], onUpdate: NoAction)

  @@index([companyId])
  @@index([expenseId])
  @@map("payrolls")
}

model PurchaseRequest {
  id               String                  @id @default(cuid())
  requestNumber    String                  @unique @map("request_number") // Autogenerado
  companyId        String                  @map("company_id")
  departmentId     String?                 @map("department_id")
  requestDate      DateTime                @default(now()) @map("request_date")
  requestingArea   String                  @map("requesting_area") // Área solicitante
  requestedBy      String                  @map("requested_by") // ID del usuario solicitante
  requestType      PurchaseRequestType     @default(REPOSICION) @map("request_type")
  priority         PurchaseRequestPriority @default(MEDIA)
  status           PurchaseRequestStatus   @default(PENDIENTE)
  approvedBy       String?                 @map("approved_by") // ID del usuario que aprobó
  approvedAt       DateTime?               @map("approved_at")
  rejectedReason   String?                 @map("rejected_reason")
  quotationUrl     String?                 @map("quotation_url") // URL de cotización subida
  purchaseOrderUrl String?                 @map("purchase_order_url") // URL de OC subida
  evidenceUrl      String?                 @map("evidence_url") // URL de evidencia de recepción
  purchasedAt      DateTime?               @map("purchased_at")
  receivedAt       DateTime?               @map("received_at")
  expenseId        String?                 @map("expense_id")
  notes            String?                 @db.Text
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")
  company          Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department       Department?             @relation("DepartmentRequests", fields: [departmentId], references: [id], onDelete: SetNull)
  expense          Expense?                @relation("ExpensePurchaseRequests", fields: [expenseId], references: [id], onUpdate: NoAction)
  items            PurchaseRequestItem[]

  @@index([companyId])
  @@index([departmentId])
  @@index([status])
  @@index([priority])
  @@index([requestType])
  @@index([requestNumber])
  @@map("purchase_requests")
}

model PurchaseRequestItem {
  id                String          @id @default(cuid())
  purchaseRequestId String          @map("purchase_request_id")
  productId         String?         @map("product_id") // Referencia al producto del inventario
  sku               String? // Código SKU
  productName       String          @map("product_name")
  category          String?
  currentStock      Int?            @map("current_stock")
  minimumStock      Int?            @map("minimum_stock")
  requestedQuantity Int             @map("requested_quantity")
  reason            String? // Motivo: Agotado, Alta demanda, Proyecto
  lastSaleDate      DateTime?       @map("last_sale_date")
  monthlyAverage    Float?          @map("monthly_average") // Promedio de ventas mensuales
  unitCost          Float?          @map("unit_cost")
  totalCost         Float?          @map("total_cost")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  product           Product?        @relation(fields: [productId], references: [id])

  @@index([purchaseRequestId])
  @@index([productId])
  @@map("purchase_request_items")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  USER
}

enum IncomeStatus {
  PAID
  PENDING
  CANCELLED
  ERROR
}

enum ExpenseStatus {
