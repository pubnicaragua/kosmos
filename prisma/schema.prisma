generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  password        String
  name            String
  avatar          String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  notifications   Notification[]
  refreshTokens   RefreshToken[]
  userCompanies   UserCompany[]
  userPreferences UserPreferences?
  ticketComments  TicketComment[]

  @@map("users")
}

model Company {
  id                 String              @id @default(cuid())
  name               String
  logo               String?
  industry           String?
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  activities         Activity[]
  clients            Client[]
  contracts          Contract[]
  customRoles        CustomRole[]
  documents          Document[]
  expenses           Expense[]
  incomes            Income[]
  marketingCampaigns MarketingCampaign[]
  opportunities      Opportunity[]
  pipelineColumns    PipelineColumn[]
  productCategories  ProductCategory[]
  products           Product[]
  quotes             Quote[]
  tickets            Ticket[]
  userCompanies      UserCompany[]

  @@map("companies")
}

model UserCompany {
  id           String      @id @default(cuid())
  userId       String      @map("user_id")
  companyId    String      @map("company_id")
  role         UserRole    @default(USER)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  customRoleId String?     @map("custom_role_id")
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customRole   CustomRole? @relation(fields: [customRoleId], references: [id])
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@map("user_companies")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Income {
  id                String       @id @default(cuid())
  companyId         String       @map("company_id")
  refNumber         String       @map("ref_number")
  client            String
  concept           String
  method            String
  amount            Float
  margin            Float
  status            IncomeStatus @default(PENDING)
  date              DateTime
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  amountSecondary   Float?       @map("amount_secondary")
  currency          String?      @default("USD")
  currencySecondary String?      @map("currency_secondary")
  customFields      Json?        @map("custom_fields")
  documento         String?
  exchangeRate      Float?       @map("exchange_rate")
  folio             String?
  origen            String?
  company           Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("incomes")
}

model Expense {
  id        String        @id @default(cuid())
  companyId String        @map("company_id")
  refNumber String?       @map("ref_number")
  provider  String
  concept   String
  category  String
  method    String
  amount    Float
  status    ExpenseStatus @default(PENDING)
  date      DateTime
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("expenses")
}

model Opportunity {
  id         String           @id @default(cuid())
  companyId  String           @map("company_id")
  title      String
  client     String
  value      Float
  stage      OpportunityStage @default(PROSPECTO)
  status     String           @default("Pendiente")
  assignedTo String?          @map("assigned_to")
  closeDate  DateTime?        @map("close_date")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("opportunities")
}

model Document {
  id         String       @id @default(cuid())
  companyId  String       @map("company_id")
  name       String
  type       DocumentType
  concept    String
  category   String?
  fileUrl    String       @map("file_url")
  fileSize   Int          @map("file_size")
  uploadedBy String       @map("uploaded_by")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  company    Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("documents")
}

model Contract {
  id         String         @id @default(cuid())
  companyId  String         @map("company_id")
  contractId String         @map("contract_id")
  name       String
  concept    String
  category   String?
  party      String
  startDate  DateTime       @map("start_date")
  endDate    DateTime       @map("end_date")
  status     ContractStatus @default(ACTIVE)
  fileUrl    String?        @map("file_url")
  uploadedBy String         @map("uploaded_by")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("contracts")
}

model Client {
  id            String       @id @default(cuid())
  companyId     String       @map("company_id")
  name          String
  email         String?
  phone         String?
  address       String?
  taxId         String?      @map("tax_id")
  status        ClientStatus @default(PROSPECTO)
  contactName   String?      @map("contact_name")
  notes         String?
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  cedula        String?
  city          String?
  country       String?
  ruc           String?
  alias         String?
  codigoInterno String?      @map("codigo_interno")
  contribuyente String?
  curso         String?
  customFields  Json?        @map("custom_fields")
  origen        String?
  phone2        String?
  sucursal      String?
  telefonoTutor String?      @map("telefono_tutor")
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quotes        Quote[]
  tickets       Ticket[]

  @@index([companyId])
  @@index([status])
  @@map("clients")
}

model Quote {
  id            String        @id @default(cuid())
  quoteNumber   String        @unique @map("quote_number")
  companyId     String        @map("company_id")
  clientId      String        @map("client_id")
  status        QuoteStatus   @default(DRAFT)
  currency      String        @default("USD")
  subtotal      Float
  discount      Float         @default(0)
  tax           Float         @default(0)
  total         Float
  validUntil    DateTime      @map("valid_until")
  notes         String?
  internalNotes String?       @map("internal_notes")
  terms         String?
  createdBy     String        @map("created_by")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  paymentMethod PaymentMethod @default(CONTADO) @map("payment_method")
  taxApplies    Boolean       @default(true) @map("tax_applies")
  items         QuoteItem[]
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([clientId])
  @@index([status])
  @@map("quotes")
}

model QuoteItem {
  id          String   @id @default(cuid())
  quoteId     String   @map("quote_id")
  productId   String?  @map("product_id")
  description String
  quantity    Int
  unitPrice   Float    @map("unit_price")
  discount    Float    @default(0)
  tax         Float    @default(0)
  total       Float
  createdAt   DateTime @default(now()) @map("created_at")
  product     Product? @relation(fields: [productId], references: [id])
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("quote_items")
}

model Product {
  id          String           @id @default(cuid())
  companyId   String           @map("company_id")
  categoryId  String?          @map("category_id")
  name        String
  sku         String
  description String?
  unit        String           @default("UNI")
  stock       Int              @default(0)
  minStock    Int              @default(0) @map("min_stock")
  cost        Float            @default(0)
  price       Float
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  category    ProductCategory? @relation(fields: [categoryId], references: [id])
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quoteItems  QuoteItem[]

  @@unique([companyId, sku])
  @@index([companyId])
  @@index([categoryId])
  @@map("products")
}

model ProductCategory {
  id          String    @id @default(cuid())
  companyId   String    @map("company_id")
  name        String
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products    Product[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("product_categories")
}

model Ticket {
  id          String          @id @default(cuid())
  companyId   String          @map("company_id")
  clientId    String?         @map("client_id")
  title       String
  description String?
  status      TicketStatus    @default(PROCESO1)
  priority    TicketPriority  @default(MEDIUM)
  assignedTo  String?         @map("assigned_to")
  amount      Float?
  dueDate     DateTime?       @map("due_date")
  closedAt    DateTime?       @map("closed_at")
  createdBy   String          @map("created_by")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  client      Client?         @relation(fields: [clientId], references: [id])
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  comments    TicketComment[]

  @@index([companyId])
  @@index([status])
  @@index([assignedTo])
  @@map("tickets")
}

model TicketComment {
  id            String   @id @default(cuid())
  ticketId      String   @map("ticket_id")
  userId        String   @map("user_id")
  content       String   @db.Text
  attachmentUrl String?  @map("attachment_url")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  ticket        Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([userId])
  @@map("ticket_comments")
}

model Activity {
  id          String         @id @default(cuid())
  companyId   String         @map("company_id")
  type        ActivityType
  title       String
  description String?
  client      String?
  status      ActivityStatus @default(PENDING)
  priority    String?
  assignedTo  String?        @map("assigned_to")
  dueDate     DateTime       @map("due_date")
  completedAt DateTime?      @map("completed_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  meetingLink String?        @map("meeting_link")
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("activities")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  type      String
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model UserPreferences {
  id            String   @id @default(cuid())
  userId        String   @unique @map("user_id")
  ticketColumns Json?    @map("ticket_columns")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model PipelineColumn {
  id        String   @id @default(cuid())
  companyId String   @map("company_id")
  name      String
  color     String   @default("#6366f1")
  order     Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])
  @@map("pipeline_columns")
}

model CustomRole {
  id            String           @id @default(cuid())
  companyId     String           @map("company_id")
  name          String
  description   String?
  color         String           @default("#6366f1")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permissions   RolePermission[]
  userCompanies UserCompany[]

  @@unique([companyId, name])
  @@map("custom_roles")
}

model RolePermission {
  id           String     @id @default(cuid())
  customRoleId String     @map("custom_role_id")
  module       String
  canView      Boolean    @default(true) @map("can_view")
  canCreate    Boolean    @default(false) @map("can_create")
  canEdit      Boolean    @default(false) @map("can_edit")
  canDelete    Boolean    @default(false) @map("can_delete")
  canExport    Boolean    @default(false) @map("can_export")
  customRole   CustomRole @relation(fields: [customRoleId], references: [id], onDelete: Cascade)

  @@unique([customRoleId, module])
  @@map("role_permissions")
}

model MarketingCampaign {
  id             String           @id @default(cuid())
  companyId      String           @map("company_id")
  name           String
  description    String?
  channel        MarketingChannel
  status         MarketingStatus  @default(PLANIFICACION)
  budget         Float?
  spent          Float            @default(0)
  startDate      DateTime?        @map("start_date")
  endDate        DateTime?        @map("end_date")
  targetAudience String?          @map("target_audience")
  metrics        String?
  assignedTo     String?          @map("assigned_to")
  createdBy      String           @map("created_by")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  adType         String?          @map("ad_type")
  approvalStatus String?          @default("PENDING") @map("approval_status")
  approvedAt     DateTime?        @map("approved_at")
  approvedBy     String?          @map("approved_by")
  evidenceUrl    String?          @map("evidence_url")
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([status])
  @@index([channel])
  @@index([approvalStatus])
  @@map("marketing_campaigns")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  USER
}

enum IncomeStatus {
  PAID
  PENDING
  CANCELLED
  ERROR
}

enum ExpenseStatus {
  PAID
  PENDING
  CANCELLED
}

enum ActivityType {
  CALL
  MEETING
  QUOTE
  OTHER
}

enum ActivityStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum OpportunityStage {
  PROSPECTO
  PROPUESTA
  NEGOCIACION
  CALIFICADO
}

enum DocumentType {
  DOC
  PDF
  XLSX
  PNG
  OTHER
}

enum ContractStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
}

enum ClientStatus {
  PROSPECTO
  PROPUESTA
  NEGOCIACION
  CALIFICADO
  ACTIVO
  INACTIVO
}

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
}

enum TicketStatus {
  PROCESO1
  PROCESO2
  PROCESO3
  PROCESO4
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum PaymentMethod {
  CONTADO
  CREDITO
}

enum MarketingStatus {
  PLANIFICACION
  EN_CURSO
  PAUSADA
  COMPLETADA
  CANCELADA
}

enum MarketingChannel {
  REDES_SOCIALES
  EMAIL
  PUBLICIDAD_DIGITAL
  CONTENIDO
  EVENTOS
  OTRO
}
