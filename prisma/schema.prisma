generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  password        String
  name            String
  avatar          String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  notifications   Notification[]
  quotesCreated   Quote[]          @relation("QuoteCreatedBy")
  refreshTokens   RefreshToken[]
  templates       Template[]
  ticketComments  TicketComment[]
  ticketMembers   TicketMember[]
  userCompanies   UserCompany[]
  userDepartments UserDepartment[] @relation("UserDepartmentUser")

  @@map("users")
}

model Company {
  id                     String                  @id @default(cuid())
  name                   String
  logo                   String?
  industry               String?
  isActive               Boolean                 @default(true) @map("is_active")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  quotePrimaryColor      String?                 @map("quote_primary_color")
  quoteHeaderHtml        String?                 @map("quote_header_html")
  quoteFooterHtml        String?                 @map("quote_footer_html")
  quoteTerms             String?                 @map("quote_terms")
  invoicePrimaryColor    String?                 @map("invoice_primary_color")
  invoiceHeaderHtml      String?                 @map("invoice_header_html")
  invoiceFooterHtml      String?                 @map("invoice_footer_html")
  ticketStages           Json?                   @map("ticket_stages")
  exchangeRate           Float?                  @default(36.62) @map("exchange_rate")
  activities             Activity[]
  clients                Client[]
  contracts              Contract[]
  customRoles            CustomRole[]
  departments            Department[]
  documents              Document[]
  employees              Employee[]              @relation("CompanyEmployees")
  expenses               Expense[]
  incomes                Income[]
  marketingCampaigns     MarketingCampaign[]
  opportunities          Opportunity[]
  payrolls               Payroll[]               @relation("CompanyPayrolls")
  pipelineColumns        PipelineColumn[]
  productCategories      ProductCategory[]
  products               Product[]
  purchaseRequestReasons PurchaseRequestReason[]
  purchaseRequests       PurchaseRequest[]
  quotes                 Quote[]
  taskAssignments        TaskAssignment[]
  taskLists              TaskList[]
  templates              Template[]
  tickets                Ticket[]
  userCompanies          UserCompany[]

  @@map("companies")
}

model UserCompany {
  id           String      @id @default(cuid())
  userId       String      @map("user_id")
  companyId    String      @map("company_id")
  role         UserRole    @default(USER)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  customRoleId String?     @map("custom_role_id")
  custom_role  String?
  customRole   CustomRole? @relation(fields: [customRoleId], references: [id], onUpdate: NoAction, map: "fk_user_companies_custom_role")
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@map("user_companies")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Income {
  id                String       @id @default(cuid())
  companyId         String       @map("company_id")
  refNumber         String       @map("ref_number")
  client            String
  concept           String
  method            String
  amount            Float
  margin            Float
  status            IncomeStatus @default(PENDING)
  date              DateTime
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  amountSecondary   Float?       @map("amount_secondary")
  currency          String?      @default("USD")
  currencySecondary String?      @map("currency_secondary")
  customFields      Json?        @map("custom_fields")
  documento         String?
  exchangeRate      Float?       @map("exchange_rate")
  folio             String?
  origen            String?
  clientId          String?      @map("client_id")
  clientRelation    Client?      @relation(fields: [clientId], references: [id])
  company           Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("incomes")
}

model Expense {
  id               String            @id @default(cuid())
  companyId        String            @map("company_id")
  refNumber        String?           @map("ref_number")
  provider         String
  concept          String
  category         String
  method           String
  amount           Float
  status           ExpenseStatus     @default(PENDING)
  date             DateTime
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payrolls         Payroll[]         @relation("ExpensePayrolls")
  purchaseRequests PurchaseRequest[] @relation("ExpensePurchaseRequests")

  @@map("expenses")
}

model Opportunity {
  id            String           @id @default(cuid())
  companyId     String           @map("company_id")
  title         String
  client        String
  value         Float
  stage         OpportunityStage @default(PROSPECTO)
  status        String           @default("Pendiente")
  order         Int              @default(0)
  assignedTo    String?          @map("assigned_to")
  assignedUsers String?          @map("assigned_users")
  currency      String           @default("USD")
  closeDate     DateTime?        @map("close_date")
  priority      String?          @default("MEDIA")
  description   String?
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("opportunities")
}

model Document {
  id         String       @id @default(cuid())
  companyId  String       @map("company_id")
  name       String
  type       DocumentType
  concept    String
  category   String?
  area       String?      @default("General")
  visibility String?      @default("COMPARTIDO")
  sharedWith String?      @map("shared_with")
  fileUrl    String       @map("file_url")
  fileSize   Int          @map("file_size")
  uploadedBy String       @map("uploaded_by")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  company    Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("documents")
}

model Contract {
  id         String         @id @default(cuid())
  companyId  String         @map("company_id")
  contractId String         @map("contract_id")
  name       String
  concept    String
  category   String?
  party      String
  startDate  DateTime       @map("start_date")
  endDate    DateTime       @map("end_date")
  status     ContractStatus @default(ACTIVE)
  area       String?        @default("General")
  visibility String?        @default("COMPARTIDO")
  sharedWith String?        @map("shared_with")
  fileUrl    String?        @map("file_url")
  uploadedBy String         @map("uploaded_by")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("contracts")
}

model Client {
  id            String       @id @default(cuid())
  companyId     String       @map("company_id")
  name          String
  email         String?
  phone         String?
  address       String?
  taxId         String?      @map("tax_id")
  status        ClientStatus @default(PROSPECTO)
  contactName   String?      @map("contact_name")
  notes         String?
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  cedula        String?
  city          String?
  country       String?
  ruc           String?
  alias         String?
  codigoInterno String?      @map("codigo_interno")
  contribuyente String?
  curso         String?
  customFields  Json?        @map("custom_fields")
  origen        String?
  phone2        String?
  sucursal      String?
  telefonoTutor String?      @map("telefono_tutor")
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  incomes       Income[]
  quotes        Quote[]
  tickets       Ticket[]

  @@index([companyId])
  @@index([status])
  @@map("clients")
}

model Quote {
  id               String        @id @default(cuid())
  quoteNumber      String        @unique @map("quote_number")
  companyId        String        @map("company_id")
  clientId         String        @map("client_id")
  contactName      String?       @map("contact_name")
  contactEmail     String?       @map("contact_email")
  contactPhone     String?       @map("contact_phone")
  assignedTo       String?       @map("assigned_to")
  clientType       ClientType    @default(NUEVO) @map("client_type")
  status           QuoteStatus   @default(DRAFT)
  closeProbability Int?          @default(50) @map("close_probability")
  currency         String        @default("USD")
  subtotal         Float
  discount         Float         @default(0)
  tax              Float         @default(0)
  total            Float
  issueDate        DateTime      @default(now()) @map("issue_date")
  validUntil       DateTime      @map("valid_until")
  sentAt           DateTime?     @map("sent_at")
  approvedAt       DateTime?     @map("approved_at")
  rejectedAt       DateTime?     @map("rejected_at")
  rejectionReason  String?       @map("rejection_reason")
  closedAt         DateTime?     @map("closed_at")
  notes            String?
  internalNotes    String?       @map("internal_notes")
  terms            String?
  createdBy        String        @map("created_by")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  paymentMethod    PaymentMethod @default(CONTADO) @map("payment_method")
  taxApplies       Boolean       @default(true) @map("tax_applies")
  items            QuoteItem[]
  client           Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  company          Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdByUser    User          @relation("QuoteCreatedBy", fields: [createdBy], references: [id])

  @@index([companyId])
  @@index([clientId])
  @@index([status])
  @@index([assignedTo])
  @@index([clientType])
  @@map("quotes")
}

model QuoteItem {
  id          String   @id @default(cuid())
  quoteId     String   @map("quote_id")
  productId   String?  @map("product_id")
  description String
  quantity    Int
  unitPrice   Float    @map("unit_price")
  discount    Float    @default(0)
  tax         Float    @default(0)
  total       Float
  createdAt   DateTime @default(now()) @map("created_at")
  product     Product? @relation(fields: [productId], references: [id])
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("quote_items")
}

model Product {
  id                   String                @id @default(cuid())
  companyId            String                @map("company_id")
  categoryId           String?               @map("category_id")
  name                 String
  sku                  String
  description          String?
  type                 String                @default("PRODUCTO")
  unit                 String                @default("UNI")
  stock                Int                   @default(0)
  minStock             Int                   @default(0) @map("min_stock")
  cost                 Float                 @default(0)
  price                Float
  netMargin            Float?                @map("net_margin")
  promotion            String?
  isActive             Boolean               @default(true) @map("is_active")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  category             ProductCategory?      @relation(fields: [categoryId], references: [id])
  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseRequestItems PurchaseRequestItem[]
  quoteItems           QuoteItem[]

  @@unique([companyId, sku])
  @@index([companyId])
  @@index([categoryId])
  @@map("products")
}

model ProductCategory {
  id          String    @id @default(cuid())
  companyId   String    @map("company_id")
  name        String
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products    Product[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("product_categories")
}

model Ticket {
  id               String            @id @default(cuid())
  ticketNumber     String            @unique @map("ticket_number")
  companyId        String            @map("company_id")
  clientId         String?           @map("client_id")
  title            String
  description      String?
  type             String            @default("SOPORTE_REMOTO")
  status           String            @default("NUEVO")
  priority         String            @default("MEDIA")
  assignedTo       String?           @map("assigned_to")
  assignedUsers    String?           @map("assigned_users")
  branch           String?
  isInternal       Boolean           @default(false) @map("is_internal")
  hasCharge        Boolean           @default(false) @map("has_charge")
  amount           Float?
  currency         String            @default("USD")
  startDate        DateTime?         @map("start_date")
  dueDate          DateTime?         @map("due_date")
  closedAt         DateTime?         @map("closed_at")
  attachments      String?
  tags             String?
  equipmentType    String?           @map("equipment_type")
  equipmentBrand   String?           @map("equipment_brand")
  equipmentModel   String?           @map("equipment_model")
  serialNumber     String?           @map("serial_number")
  installationDate DateTime?         @map("installation_date")
  installedBy      String?           @map("installed_by")
  evidence         String?
  customField1     String?           @map("custom_field_1")
  customField2     String?           @map("custom_field_2")
  customField3     String?           @map("custom_field_3")
  customField4     String?           @map("custom_field_4")
  customField5     String?           @map("custom_field_5")
  responseTime     Int?              @map("response_time")
  resolutionTime   Int?              @map("resolution_time")
  reopenedCount    Int               @default(0) @map("reopened_count")
  createdBy        String            @map("created_by")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  auditLogs        TicketAuditLog[]
  checklists       TicketChecklist[]
  comments         TicketComment[]
  members          TicketMember[]
  subTasks         TicketSubTask[]
  client           Client?           @relation(fields: [clientId], references: [id])
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([status])
  @@index([priority])
  @@index([type])
  @@index([assignedTo])
  @@index([clientId])
  @@index([ticketNumber])
  @@index([dueDate])
  @@map("tickets")
}

model TicketComment {
  id            String   @id @default(cuid())
  ticketId      String   @map("ticket_id")
  userId        String   @map("user_id")
  content       String
  attachmentUrl String?  @map("attachment_url")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  ticket        Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([userId])
  @@map("ticket_comments")
}

model TicketMember {
  id        String   @id @default(cuid())
  ticketId  String   @map("ticket_id")
  userId    String   @map("user_id")
  role      String   @default("member")
  addedBy   String   @map("added_by")
  createdAt DateTime @default(now()) @map("created_at")
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ticketId, userId])
  @@index([ticketId])
  @@index([userId])
  @@map("ticket_members")
}

model TicketChecklist {
  id        String                @id @default(cuid())
  ticketId  String                @map("ticket_id")
  title     String
  position  Int                   @default(0)
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt @map("updated_at")
  items     TicketChecklistItem[]
  ticket    Ticket                @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_checklists")
}

model TicketChecklistItem {
  id          String          @id @default(cuid())
  checklistId String          @map("checklist_id")
  content     String
  isCompleted Boolean         @default(false) @map("is_completed")
  completedBy String?         @map("completed_by")
  completedAt DateTime?       @map("completed_at")
  position    Int             @default(0)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  checklist   TicketChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId])
  @@map("ticket_checklist_items")
}

model TicketSubTask {
  id          String    @id @default(cuid())
  ticketId    String    @map("ticket_id")
  title       String
  description String?
  assignedTo  String?   @map("assigned_to")
  status      String    @default("PENDIENTE")
  priority    String    @default("MEDIA")
  dueDate     DateTime? @map("due_date")
  completedAt DateTime? @map("completed_at")
  createdBy   String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  ticket      Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([assignedTo])
  @@map("ticket_sub_tasks")
}

model TicketAuditLog {
  id        String   @id @default(cuid())
  ticketId  String   @map("ticket_id")
  userId    String   @map("user_id")
  action    String
  field     String?
  oldValue  String?
  newValue  String?
  metadata  String?
  createdAt DateTime @default(now()) @map("created_at")
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([userId])
  @@index([createdAt])
  @@map("ticket_audit_logs")
}

model Activity {
  id          String         @id @default(cuid())
  companyId   String         @map("company_id")
  type        ActivityType
  title       String
  description String?
  client      String?
  status      ActivityStatus @default(PENDING)
  priority    String?
  assignedTo  String?        @map("assigned_to")
  dueDate     DateTime       @map("due_date")
  completedAt DateTime?      @map("completed_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  meetingLink String?        @map("meeting_link")
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("activities")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  type      String
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model PipelineColumn {
  id        String   @id @default(cuid())
  companyId String   @map("company_id")
  user_id   String?
  name      String
  color     String   @default("#6366f1")
  order     Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, user_id, name])
  @@index([companyId])
  @@index([user_id])
  @@map("pipeline_columns")
}

model CustomRole {
  id            String           @id @default(cuid()) @db.VarChar(30)
  companyId     String           @map("company_id") @db.VarChar(30)
  name          String           @db.VarChar(255)
  description   String?
  color         String           @default("#6366f1") @db.VarChar(20)
  is_default    Boolean          @default(false)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  permissions   RolePermission[]
  userCompanies UserCompany[]

  @@unique([companyId, name])
  @@map("custom_roles")
}

model RolePermission {
  id           String     @id @default(cuid()) @db.VarChar(30)
  customRoleId String     @map("custom_role_id") @db.VarChar(30)
  module       String     @db.VarChar(100)
  canView      Boolean    @default(false) @map("can_view")
  canCreate    Boolean    @default(false) @map("can_create")
  canEdit      Boolean    @default(false) @map("can_edit")
  canDelete    Boolean    @default(false) @map("can_delete")
  canExport    Boolean    @default(false) @map("can_export")
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  updated_at   DateTime   @default(now()) @db.Timestamptz(6)
  customRole   CustomRole @relation(fields: [customRoleId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([customRoleId, module])
  @@map("role_permissions")
}

model MarketingCampaign {
  id             String           @id @default(cuid())
  companyId      String           @map("company_id")
  name           String
  description    String?
  channel        MarketingChannel
  status         MarketingStatus  @default(PLANIFICACION)
  budget         Float?
  spent          Float            @default(0)
  startDate      DateTime?        @map("start_date")
  endDate        DateTime?        @map("end_date")
  targetAudience String?          @map("target_audience")
  metrics        String?
  assignedTo     String?          @map("assigned_to")
  createdBy      String           @map("created_by")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([status])
  @@index([channel])
  @@map("marketing_campaigns")
}

model Employee {
  id                   String    @id @default(cuid())
  companyId            String    @map("company_id")
  employeeCode         String    @unique @map("employee_code")
  fullName             String    @map("full_name")
  email                String?
  phone                String?
  position             String
  department           String
  startDate            DateTime  @map("start_date")
  salary               Float
  contractType         String    @map("contract_type")
  bankName             String?   @map("bank_name")
  accountNumber        String?   @map("account_number")
  address              String?
  birthDate            DateTime? @map("birth_date")
  emergencyContact     String?   @map("emergency_contact")
  emergencyPhone       String?   @map("emergency_phone")
  socialSecurityNumber String?   @map("social_security_number")
  bloodType            String?   @map("blood_type")
  educationLevel       String?   @map("education_level")
  benefits             String?
  status               String    @default("ACTIVO")
  photo                String?
  notes                String?
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  company              Company   @relation("CompanyEmployees", fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([status])
  @@index([employeeCode])
  @@map("employees")
}

model Payroll {
  id          String   @id @default(cuid())
  companyId   String
  name        String?
  period      String
  fileName    String
  fileUrl     String
  totalAmount Float
  status      String   @default("PENDIENTE")
  notes       String?
  expenseId   String?
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  company     Company  @relation("CompanyPayrolls", fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  expense     Expense? @relation("ExpensePayrolls", fields: [expenseId], references: [id], onUpdate: NoAction)

  @@index([companyId])
  @@index([expenseId])
  @@map("payrolls")
}

model PurchaseRequest {
  id                   String                  @id @default(cuid())
  requestNumber        String                  @unique @map("request_number")
  companyId            String                  @map("company_id")
  departmentId         String?                 @map("department_id")
  requestDate          DateTime                @default(now()) @map("request_date")
  requestingArea       String                  @map("requesting_area")
  requestedBy          String                  @map("requested_by")
  requestType          PurchaseRequestType     @default(REPOSICION) @map("request_type")
  priority             PurchaseRequestPriority @default(MEDIA)
  status               PurchaseRequestStatus   @default(PENDIENTE)
  approvedBy           String?                 @map("approved_by")
  approvedAt           DateTime?               @map("approved_at")
  rejectedReason       String?                 @map("rejected_reason")
  quotationUrl         String?                 @map("quotation_url")
  purchaseOrderUrl     String?                 @map("purchase_order_url")
  evidenceUrl          String?                 @map("evidence_url")
  purchasedAt          DateTime?               @map("purchased_at")
  receivedAt           DateTime?               @map("received_at")
  expenseId            String?                 @map("expense_id")
  notes                String?
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")
  currency             String                  @default("USD")
  finalAmount          Float?                  @map("final_amount")
  quotationFiles       Json?                   @map("quotation_files")
  selectedQuotationUrl String?                 @map("selected_quotation_url")
  supplierName         String?                 @map("supplier_name")
  items                PurchaseRequestItem[]
  company              Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department           Department?             @relation("DepartmentRequests", fields: [departmentId], references: [id])
  expense              Expense?                @relation("ExpensePurchaseRequests", fields: [expenseId], references: [id], onUpdate: NoAction)

  @@index([companyId])
  @@index([departmentId])
  @@index([status])
  @@index([priority])
  @@index([requestType])
  @@index([requestNumber])
  @@map("purchase_requests")
}

model PurchaseRequestItem {
  id                String          @id @default(cuid())
  purchaseRequestId String          @map("purchase_request_id")
  productId         String?         @map("product_id")
  sku               String?
  productName       String          @map("product_name")
  category          String?
  currentStock      Int?            @map("current_stock")
  minimumStock      Int?            @map("minimum_stock")
  requestedQuantity Int             @map("requested_quantity")
  reason            String?
  lastSaleDate      DateTime?       @map("last_sale_date")
  monthlyAverage    Float?          @map("monthly_average")
  unitCost          Float?          @map("unit_cost")
  totalCost         Float?          @map("total_cost")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  product           Product?        @relation(fields: [productId], references: [id])
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)

  @@index([purchaseRequestId])
  @@index([productId])
  @@map("purchase_request_items")
}

model Template {
  id        String       @id @default(cuid())
  name      String
  type      TemplateType
  fileUrl   String?
  content   String?
  module    String
  isActive  Boolean      @default(true)
  companyId String
  createdBy String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  company   Company      @relation(fields: [companyId], references: [id])
  user      User         @relation(fields: [createdBy], references: [id])

  @@map("templates")
}

model Department {
  id               String            @id @default(cuid())
  name             String
  description      String?
  companyId        String            @map("company_id")
  isActive         Boolean           @default(true) @map("is_active")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseRequests PurchaseRequest[] @relation("DepartmentRequests")
  userDepartments  UserDepartment[]

  @@map("departments")
}

model UserDepartment {
  id           String     @id @default(cuid())
  userId       String     @map("user_id")
  departmentId String     @map("department_id")
  role         String?
  isApprover   Boolean    @default(false) @map("is_approver")
  createdAt    DateTime   @default(now()) @map("created_at")
  isReceiver   Boolean    @default(false) @map("is_receiver")
  isBuyer      Boolean    @default(false) @map("is_buyer")
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user         User       @relation("UserDepartmentUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
  @@map("user_departments")
}

model TaskList {
  id              String           @id @default(cuid())
  companyId       String           @map("company_id")
  name            String
  description     String?
  area            String?
  frequency       TaskFrequency    @default(DAILY)
  isActive        Boolean          @default(true) @map("is_active")
  requireEvidence Boolean          @default(false) @map("require_evidence")
  createdBy       String           @map("created_by")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  assignments     TaskAssignment[]
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  templates       TaskTemplate[]

  @@index([companyId])
  @@index([area])
  @@index([frequency])
  @@map("task_lists")
}

model TaskTemplate {
  id               String          @id @default(cuid())
  taskListId       String          @map("task_list_id")
  title            String
  description      String?
  order            Int             @default(0)
  requirePhoto     Boolean         @default(false) @map("require_photo")
  requireVideo     Boolean         @default(false) @map("require_video")
  estimatedMinutes Int?            @map("estimated_minutes")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  executions       TaskExecution[]
  taskList         TaskList        @relation(fields: [taskListId], references: [id], onDelete: Cascade)

  @@index([taskListId])
  @@index([order])
  @@map("task_templates")
}

model TaskAssignment {
  id          String          @id @default(cuid())
  companyId   String          @map("company_id")
  taskListId  String          @map("task_list_id")
  assignedTo  String          @map("assigned_to")
  assignedBy  String          @map("assigned_by")
  dueDate     DateTime?       @map("due_date")
  priority    TaskPriority    @default(MEDIUM)
  status      TaskStatus      @default(PENDING)
  startedAt   DateTime?       @map("started_at")
  completedAt DateTime?       @map("completed_at")
  notes       String?
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  taskList    TaskList        @relation(fields: [taskListId], references: [id], onDelete: Cascade)
  executions  TaskExecution[]

  @@index([companyId])
  @@index([assignedTo])
  @@index([status])
  @@index([dueDate])
  @@map("task_assignments")
}

model TaskExecution {
  id               String         @id @default(cuid())
  assignmentId     String         @map("assignment_id")
  templateId       String         @map("template_id")
  completed        Boolean        @default(false)
  completedAt      DateTime?      @map("completed_at")
  completedBy      String?        @map("completed_by")
  evidencePhotoUrl String?        @map("evidence_photo_url")
  evidenceVideoUrl String?        @map("evidence_video_url")
  notes            String?
  latitude         Float?
  longitude        Float?
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  assignment       TaskAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  template         TaskTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@index([completed])
  @@map("task_executions")
}

model TaskNotification {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  assignmentId String?   @map("assignment_id")
  title        String
  message      String
  type         String    @default("TASK_ASSIGNED")
  read         Boolean   @default(false)
  readAt       DateTime? @map("read_at")
  sentPush     Boolean   @default(false) @map("sent_push")
  pushSentAt   DateTime? @map("push_sent_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([read])
  @@map("task_notifications")
}

model PushSubscription {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  endpoint   String   @unique
  keys       Json
  deviceInfo String?  @map("device_info")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("push_subscriptions")
}

model PurchaseRequestReason {
  id          String              @id @default(cuid())
  companyId   String              @map("company_id")
  requestType PurchaseRequestType @map("request_type")
  name        String
  description String?
  isActive    Boolean             @default(true) @map("is_active")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, requestType, name])
  @@index([companyId])
  @@index([requestType])
  @@map("purchase_request_reasons")
}

